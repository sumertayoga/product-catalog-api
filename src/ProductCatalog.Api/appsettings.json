{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "ProductCatalog.Api",
    "Audience": "ProductCatalog.Client",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ApiDocs": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
