@baseUrl = http://localhost:5183
@productId = 1

### Create product
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Laptop",
  "description": "14 inch",
  "price": 999.99
}

### Get product by id
GET {{baseUrl}}/api/products/{{productId}}

### Update product
PUT {{baseUrl}}/api/products/{{productId}}
Content-Type: application/json

{
  "name": "Laptop Pro",
  "description": "16 inch",
  "price": 1299.00
}

### Delete product
DELETE {{baseUrl}}/api/products/{{productId}}

### List all products
GET {{baseUrl}}/api/products

### Search by name (case-insensitive)
GET {{baseUrl}}/api/products?name=lap

### Search by price range (inclusive)
GET {{baseUrl}}/api/products?minPrice=10&maxPrice=30

### Paging
GET {{baseUrl}}/api/products?page=2&pageSize=2

### Invalid: min price greater than max price -> 400
GET {{baseUrl}}/api/products?minPrice=100&maxPrice=10

### Invalid: empty name and zero price -> 400
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "",
  "price": 0
}
